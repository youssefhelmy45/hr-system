    {
      "parameters": {
        "jsCode": "const raw = $json.text.trim()\n  .replace(/^```(?:json)?\\s*/i, '')\n  .replace(/\\s*```$/, '');\n\nconst evaluation = JSON.parse(raw);\nconst score = evaluation.score;\n\nif (\n  typeof score !== 'number' ||\n  !Number.isInteger(score) ||\n  score < 0 ||\n  score > 100\n) {\n  throw new Error('Score must be an integer between 0 and 100.');\n}\n\nif (\n  typeof evaluation.score_reason !== 'string' ||\n  !evaluation.score_reason.trim()\n) {\n  throw new Error('Score reason is missing.');\n}\n\nreturn {\n  json: {\n    score,\n    score_reason: evaluation.score_reason,\n    review_notes: evaluation.review_notes ?? [],\n    priority: score >= 75 ? 'High' : score >= 50 ? 'Medium' : 'Low'\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3664,
        -80
